# Hugging Face — Inference Providers / Hub
# Токен: https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# НЕ ставь auto — будет model_not_supported, если провайдер не выбран явно.
# Раннер сам подставит preferred_provider из каталога, если оставить auto.
# Примеры: featherless-ai | novita | deepinfra
HF_PROVIDER=auto

# Таймаут одного вызова (сек)
HF_TIMEOUT=180

# ────────────────────────────────────────────────────────────────
# HTTP-сервис конвейера (backend/service)
#
# Этот файл — единый источник настроек: его читает и локальный запуск
# (run-local.bat), и docker-compose (через env_file). Здесь только «что
# делать»; «где лежит» (пути к uploads, прогонам, состоянию) задаёт способ
# запуска, потому что в контейнере и на диске они разные.
# ────────────────────────────────────────────────────────────────

# real — настоящий прогон VLM (~2 мин и токены на лист, страницы уходят
#        стороннему провайдеру);
# mock — имитация без обращения к модели, лист за ~1.5 с, вывод помечен [MOCK].
PTO_PIPELINE_MODE=mock

# id из каталога: python hf_api_bench.py --list
PTO_MODEL=qwen3vl-32b

# Порт сервиса. Фронтенд занимает 8080.
PTO_SERVICE_PORT=8000

# Флаги качества прогона (1/0).
PTO_SHEET_AWARE=1
PTO_TWO_PASS=1
PTO_LAYER_AWARE=1

# Разделение ролей проходов: PASS-A описывает лист один раз, PASS-B только
# вычитывает текст. Выключать имеет смысл лишь для сравнения со старым
# поведением, где каждый проход пересказывал лист целиком.
PTO_LEAN=1

# Тест-сетовые подсказки по номеру страницы. На PDF заказчика вредны:
# подсказывают модели то, чего на листе нет. Держать выключенными.
PTO_ZONE_HINTS=0

# Сколько листов считать одновременно. По умолчанию 1: листы идут по порядку,
# потому что страницы документа бывают связаны (таблица переходит на следующий
# лист, узел ссылается на разрез). Провайдер держит 3 потока (вдвое быстрее,
# без отказов) — включайте осознанно, когда порядок не важен.
PTO_PAGE_CONCURRENCY=1

# Выводить ли в интерфейс извлечение по фрагментам (PASS-B). На чертеже это
# 16 подробных описаний, до 100 тыс. символов на лист — читать невозможно.
# При 0 данные остаются в файле прогона и в GET /jobs/{id}/pages/{n}/raw.
PTO_INCLUDE_FRAGMENTS=0

# Общий секрет для API. Пусто — сервис открыт (нормально на localhost).
# На сервере задайте: иначе любой, кто дотянется до порта, поставит документ
# в очередь и потратит ваши деньги. Клиент шлёт его в X-PTO-Token.
# Открытым остаётся только /health — его дёргает healthcheck контейнера.
PTO_API_TOKEN=

# Задержка на лист в режиме mock (сек).
PTO_MOCK_PAGE_SECONDS=1.5

# ── Расшифровка голосовых замечаний (POST /transcribe) ──────────────────────
# Сам Whisper — отдельная служба, бэкенд к нему только ходит. Способ выбирается
# сам: задан URL — по HTTP; стоит faster-whisper — в процессе; режим mock —
# заглушка. auto|http|local|mock|off
PTO_WHISPER_MODE=auto
# Эндпоинт целиком, протокол OpenAI Audio API. В докере обе переменные уже
# заданы в docker-compose.yml (сервис whisper), здесь трогать не нужно —
# оставьте пусто. Заполняйте, только если запускаете сервис без докера или
# Whisper живёт на другой машине.
# ВАЖНО: из контейнера бэкенда 127.0.0.1 — это он сам, а не хост. Соседний
# контейнер адресуется именем сервиса: http://whisper:8000/v1/audio/transcriptions
PTO_WHISPER_URL=
PTO_WHISPER_TOKEN=
# Модель в поле model запроса. Для speaches/faster-whisper это id с Hugging
# Face: Systran/faster-whisper-small (~500 МБ) — компромисс скорости и
# разборчивости русского; -base быстрее и врёт на терминах, -medium точнее,
# но фразу на 10 секунд считает 20-40 секунд на CPU.
PTO_WHISPER_MODEL=Systran/faster-whisper-small
# Документация русская — язык не угадываем, а задаём.
PTO_WHISPER_LANGUAGE=ru
# Сколько секунд ждать расшифровку. Фронт всё равно обрывает запрос через 60,
# поэтому больше имеет смысл только для проверки с сервера через curl.
PTO_WHISPER_TIMEOUT=60
