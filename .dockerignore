# В образ едет только код конвейера и сервиса. Всё тяжёлое и приватное —
# прогоны, PDF заказчика, эталоны, токены — остаётся снаружи.
.git
.gitignore
__pycache__/
*.py[cod]
.venv/
venv/

# Прогоны и их артефакты (сотни мегабайт)
hf_runs/
hf_runs_mock/
local_runs/
h[0-9]_*/
s[0-9]_*/
page35*_review.png
h*_contact_sheet.png
service/state/
service/state-mock/
*_viewer/
quality_viewer_*/
match_viewer*/

# Документы заказчика и эталоны
*.pdf
*.docx
*.xlsx
*.zip
*.rar
ЭТАЛОН*/
new_files/
symbols/fixtures/local/
symbols/fixtures/MANIFEST.local.json

# Секреты: .env подключается через env_file в compose, внутрь образа не кладём
.env
.env.*
!.env.example

# Локальное
run-local.bat
*.log
*.tmp
*.bak
.claude/
